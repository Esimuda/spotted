# Seed the fictional trail. Set to false for an empty life list and no demo notes.
DEMO_MODE=true

# Where SQLite and uploads live. On a paid Render disk, point this at the mount.
DATA_DIR=./data

# Run CLIP and Gemma inside the Node server.
# Leave false on a 512 MB Render instance. The phone still runs CLIP.
# Needs roughly 2 GB free for CLIP, more if Gemma is loaded too.
ENABLE_SERVER_MODELS=true

# Optional OpenAI-compatible endpoint, such as Ollama:
#   ollama pull gemma3:270m
#   GEMMA_BASE_URL=http://127.0.0.1:11434/v1
#   GEMMA_MODEL=gemma3:270m
GEMMA_BASE_URL=
GEMMA_MODEL=gemma3:270m
GEMMA_API_KEY=
